# PostgreSQL — Supabase connection string
# Transaction pooler (port 6543) for API routes on Vercel (serverless):
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Set to "false" if connecting to local Postgres without SSL
DATABASE_SSL=true

# MegaETH RPC + Etherscan key (used by poller)
ETHERSCAN_KEY=your_key_here
